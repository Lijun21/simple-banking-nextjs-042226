<!DOCTYPE html>
<html>
<head><meta charset="utf-8" /></head>
<body style="font-family: sans-serif; color: #333; max-width: 600px; margin: 0 auto; padding: 24px;">
  <h2 style="color: #1a56db;">Payment Confirmation</h2>
  <p>Hi {{customerName}},</p>
  <p>Your payment of <strong>${{amountFormatted}}</strong> to <strong>{{vendorName}}</strong> has been successfully processed.</p>

  <table style="width:100%; border-collapse:collapse; margin: 24px 0;">
    <tr style="background:#f9fafb;">
      <td style="padding:10px; border:1px solid #e5e7eb;">Confirmation #</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">{{orderId}}</td>
    </tr>
    <tr>
      <td style="padding:10px; border:1px solid #e5e7eb;">Vendor</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">{{vendorName}}</td>
    </tr>
    <tr style="background:#f9fafb;">
      <td style="padding:10px; border:1px solid #e5e7eb;">Amount Sent</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">${{amountFormatted}}</td>
    </tr>
    <tr>
      <td style="padding:10px; border:1px solid #e5e7eb;">Service Fee</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">${{feeFormatted}}</td>
    </tr>
    <tr style="background:#f9fafb; font-weight:bold;">
      <td style="padding:10px; border:1px solid #e5e7eb;">Total Charged to Card</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">${{totalFormatted}}</td>
    </tr>
    <tr>
      <td style="padding:10px; border:1px solid #e5e7eb;">Date</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">{{date}}</td>
    </tr>
    {{#if memo}}
    <tr style="background:#f9fafb;">
      <td style="padding:10px; border:1px solid #e5e7eb;">Memo</td>
      <td style="padding:10px; border:1px solid #e5e7eb;">{{memo}}</td>
    </tr>
    {{/if}}
  </table>

  <p style="color:#6b7280; font-size:14px;">Questions? Reply to this email or contact support@companyp.com</p>
  <p style="color:#6b7280; font-size:14px;">— Company P</p>
</body>
</html>
